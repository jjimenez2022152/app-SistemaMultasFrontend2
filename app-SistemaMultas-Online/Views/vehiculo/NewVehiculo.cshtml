@{
    ViewBag.Title = "newVehiculo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Bienvenidos a la pagina de registro de Vehiculos</h2>

<form action="/Vehiculo/guardar" method="post">
    <div class="panel panel-primary">

        <div class="panel-heading">
            <label>Nuevo Vehiculo</label>
        </div>

        <div class="panel-body">

            <div class="col" align="center">
                <div class="form-group">
                    <label>ID Vehiculo</label>
                    <input type="text" required class="form-control" id="id_vehiculo" name="id_vehiculo" />
                </div>
            </div>

            <div class="col" align="center">
                <div class="form-group">
                    <label>Placa</label>
                    <input type="text" required class="form-control" id="placa" name="placa" />
                </div>
            </div>

            <div class="col" align="center">
                <div class="form-group">
                    <label>Marca</label>
                    <input type="text" required class="form-control" id="marca" name="marca" />
                </div>
            </div>

            <div class="col" align="center">
                <div class="form-group">
                    <label>ID Conductor</label>
                    <input type="text" required class="form-control" id="id_conductor" name="id_conductor" />
                </div>
            </div>

            <div class="col" align="center" style="margin-top:20px;">
                <button type="submit" class="btn btn-primary" onclick="return validarGuardado();">Guardar</button>

                <button type="button"
                        class="btn btn-danger"
                        onclick="location.href='@Url.Action("Vehiculo","Vehiculo")';">
                    Cancelar
                </button>
            </div>

        </div>
    </div>
</form>