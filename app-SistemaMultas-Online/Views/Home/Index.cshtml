@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row" aria-labelledby="tituloSistema">

        <h1 id="tituloSistema">Sistema de Multas Online</h1>

        <p class="lead">
            Plataforma web desarrollada en ASP.NET MVC para la gestión de infracciones,
            conductores, vehículos, sanciones, pagos y agentes de tránsito.
        </p>

        <p>
            <a href="@Url.Action("Infraccion","Infraccion")"
               class="btn btn-primary btn-md">
                Ir a Infracciones &raquo;
            </a>
        </p>

    </section>

    <div class="row">

        <section class="col-md-4" aria-labelledby="gestionInfracciones">

            <h2 id="gestionInfracciones">Gestión de Infracciones</h2>

            <p>
                Permite registrar, actualizar y consultar infracciones de tránsito,
                asociando vehículos, agentes, sanciones y estados.
            </p>

            <p>
                <a class="btn btn-outline-dark"
                   href="@Url.Action("Infraccion","Infraccion")">
                    Ver Infracciones &raquo;
                </a>
            </p>

        </section>

        <section class="col-md-4" aria-labelledby="gestionPagos">

            <h2 id="gestionPagos">Pagos y Sanciones</h2>

            <p>
                Administra los pagos realizados por las infracciones y lleva
                el control de las sanciones registradas dentro del sistema.
            </p>

            <p>
                <a class="btn btn-outline-dark"
                   href="@Url.Action("Pago","Pago")">
                    Ver Pagos &raquo;
                </a>
            </p>

        </section>

        <section class="col-md-4" aria-labelledby="reportesSistema">

            <h2 id="reportesSistema">Reportes PDF</h2>

            <p>
                Genera reportes en PDF para entidades como agentes,
                vehículos, conductores, pagos e infracciones.
            </p>

            <p>
                <a class="btn btn-outline-dark"
                   href="@Url.Action("ReporteAgentes","Reporte")">
                    Generar Reportes &raquo;
                </a>
            </p>

        </section>

    </div>
</main>