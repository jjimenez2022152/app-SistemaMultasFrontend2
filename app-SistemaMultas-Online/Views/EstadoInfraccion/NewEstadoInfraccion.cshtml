@{
    ViewBag.Title = "newEstadoInfraccion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Registro de Estados de Infracción</h2>

<form action="/EstadoInfraccion/guardar" method="post">

    <div class="panel panel-primary">

        <div class="panel-heading">
            <label>Nuevo Estado</label>
        </div>

        <div class="panel-body">

            <div class="col" align="center">
                <div class="form-group">
                    <label>ID Estado</label>

                    <input type="text"
                           required
                           class="form-control"
                           id="id_estado"
                           name="id_estado" />
                </div>
            </div>

            <div class="col" align="center">
                <div class="form-group">
                    <label>Descripción</label>

                    <input type="text"
                           required
                           class="form-control"
                           id="descripcion"
                           name="descripcion" />
                </div>
            </div>

            <div class="col" align="center" style="margin-top:20px;">

                <button type="submit"
                        class="btn btn-primary">
                    Guardar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        onclick="location.href='@Url.Action("EstadoInfraccion","EstadoInfraccion")'">
                    Cancelar
                </button>

            </div>

        </div>

    </div>

</form>